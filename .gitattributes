# Normalizacja końców linii - bez tego całe repo potrafi się pokazać
# jako "zmodyfikowane" po przełączeniu między Windows a Linuksem.
* text=auto eol=lf

*.php text eol=lf diff=php
*.blade.php text eol=lf diff=html
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.sh text eol=lf
.env.example text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary

# Pliki, które nie muszą trafiać do archiwum z wydaniem.
/.github            export-ignore
/tests              export-ignore
.gitattributes      export-ignore
.gitignore          export-ignore
